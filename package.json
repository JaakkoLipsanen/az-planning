{
  "name": "trip-planner",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "vite app --open",
    "build": "vite build app",
    "preview": "vite preview app --open",
    "trip": "node pipeline/src/cli.ts",
    "typecheck": "tsc -p . && tsc -p app && tsc -p app/tsconfig.node.json && tsc -p pipeline",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "screenshot": "node scripts/screenshot.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "flatbush": "^4.6.2",
    "jsts": "^2.12.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pbf": "^5.1.2",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
